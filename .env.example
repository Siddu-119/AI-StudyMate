# Copy this file to server/.env. Keep actual credentials out of Git.

# Server listen port. If occupied, choose a free port and set VITE_API_URL
# in client/.env to the same backend origin.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Google Gemini API. Get a key at https://aistudio.google.com/
# Live mode is used only when a key is configured and AI_DEMO_MODE is false.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Explicitly enabled for a new local setup; set false when configuring a live key.
AI_DEMO_MODE=true
AI_REQUEST_TIMEOUT_MS=30000
