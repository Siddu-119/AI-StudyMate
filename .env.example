# Copy this file to server/.env and fill in your values.
# Never commit a real .env file or paste keys into GitHub.

# Server listen port. Default 5000.
# If you see EADDRINUSE, pick a free port (for example 5001)
# and also set VITE_API_URL in client/.env to the same origin.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# BharatCode Model API (official docs: https://bharatcode.ai/build)
# Get a developer key from https://bharatcode.ai/account
# Leave BHARATCODE_API_KEY empty to run in labelled Demo Mode.
BHARATCODE_API_KEY=
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
BHARATCODE_MODEL=qwen-3.8-27b
